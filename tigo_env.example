# ============================================================
# Tigo MMU scraper — environment configuration
# Copy to `tigo.env` (or /etc/tigo.env for systemd) and edit.
# ============================================================

# ---------- Tigo MMU (local web interface) ----------
MMU_URL=http://192.168.1.1/cgi-bin/mmdstatus
MMU_USER=user
MMU_PASS=changeme

# ---------- InfluxDB 2.x ----------
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=PUT-YOUR-INFLUX-TOKEN-HERE
INFLUX_ORG=my-org
INFLUX_BUCKET=tigo

# ---------- Measurement names ----------
PANEL_MEASUREMENT=tigo_panel
SYSTEM_MEASUREMENT=tigo_system

# ---------- Timestamps ----------
# 1 = use the timestamp shown on the MMU page, 0 = use local clock
USE_PAGE_TIMESTAMP=1
PAGE_TZ=Pacific/Auckland

# ---------- HTTP ----------
HTTP_TIMEOUT=10

# ---------- Scheduler / backoff ----------
SCRAPE_INTERVAL_SEC=10
MAX_INTERVAL_SEC=300
BACKOFF_AFTER_FAILURES=3

# ---------- Web server ----------
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8088
HEALTH_STALE_SEC=60

# ---------- Misc ----------
# Where the scraper persists its state between restarts.
# Inside Docker the compose file maps this to a named volume.
STATE_FILE=/opt/tigo/state.json
LOG_LEVEL=INFO
